{"type":"data","nodes":[null,{"type":"data","data":[{"nav":1},[2,34,135],{"label":3,"items":4},"Start",[5,18],{"title":6,"path":7,"headings":8},"Installation","/docs/installation",[9,12,15],{"id":10,"text":11},"what-you-need","What you need",{"id":13,"text":14},"get-the-template","Get the template",{"id":16,"text":17},"make-a-site","Make a site",{"title":19,"path":20,"headings":21},"Quick start","/docs/quick-start",[22,25,28,31],{"id":23,"text":24},"1-make-the-site","1. Make the site",{"id":26,"text":27},"2-fill-in-the-config","2. Fill in the config",{"id":29,"text":30},"3-write-the-docs","3. Write the docs",{"id":32,"text":33},"4-publish","4. Publish",{"label":35,"items":36},"Guide",[37,53,78,90,103,119],{"title":38,"path":39,"headings":40},"Configuration","/docs/configuration",[41,44,47,50],{"id":42,"text":43},"fields","Fields",{"id":45,"text":46},"colours","Colours",{"id":48,"text":49},"sections","Sections",{"id":51,"text":52},"the-hero","The hero",{"title":54,"path":55,"headings":56},"Writing docs","/docs/writing-docs",[57,60,63,66,69,72,75],{"id":58,"text":59},"file-names","File names",{"id":61,"text":62},"front-matter","Front matter",{"id":64,"text":65},"the-lead","The lead",{"id":67,"text":68},"headings","Headings",{"id":70,"text":71},"code","Code",{"id":73,"text":74},"links","Links",{"id":76,"text":77},"good-docs-pages","Good docs pages",{"title":79,"path":80,"headings":81},"Changelog","/docs/changelog",[82,83,84,87],{"id":58,"text":59},{"id":61,"text":62},{"id":85,"text":86},"writing-an-entry","Writing an entry",{"id":88,"text":89},"what-the-site-makes-from-it","What the site makes from it",{"title":91,"path":92,"headings":93},"Custom hero and styles","/docs/custom-code",[94,97,100],{"id":95,"text":96},"a-custom-hero","A custom hero",{"id":98,"text":99},"custom-styles","Custom styles",{"id":101,"text":102},"everything-else","Everything else",{"title":104,"path":105,"headings":106},"Deploying","/docs/deploying",[107,110,113,116],{"id":108,"text":109},"what-it-does","What it does",{"id":111,"text":112},"your-own-domain","Your own domain",{"id":114,"text":115},"taking-a-site-down","Taking a site down",{"id":117,"text":118},"somewhere-else","Somewhere else",{"title":120,"path":121,"headings":122},"Updating a site","/docs/updating",[123,126,129,132],{"id":124,"text":125},"run-it","Run it",{"id":127,"text":128},"what-it-changes","What it changes",{"id":130,"text":131},"what-it-leaves-alone","What it leaves alone",{"id":133,"text":134},"where-the-template-comes-from","Where the template comes from",{"label":136,"items":137},"Reference",[138,148],{"title":139,"path":140,"headings":141},"Agents","/docs/agents",[142,145],{"id":143,"text":144},"having-an-agent-build-the-site","Having an agent build the site",{"id":146,"text":147},"reading-a-published-site","Reading a published site",{"title":149,"path":150,"headings":151},"Limits","/docs/limits",[152,155,158,161],{"id":153,"text":154},"two-tools-on-one-site","Two tools on one site",{"id":156,"text":157},"dns-only-on-cloudflare","DNS only on Cloudflare",{"id":159,"text":160},"github-pages-needs-a-public-repository","GitHub Pages needs a public repository",{"id":162,"text":163},"template-code-is-the-templates","Template code is the template's"],"uses":{}},{"type":"data","data":[{"doc":1,"prev":7,"next":8},{"title":2,"description":3,"html":4,"path":5,"group":6},"Installation","What you need, and how to make a site for a tool.","\u003Cp class=\"lead\">toolsite is a template. You copy it once per tool, and each copy becomes that tool&#39;s site.\u003C/p>\n\u003Ch2 id=\"what-you-need\">What you need\u003Ca class=\"anchor\" href=\"#what-you-need\" aria-label=\"Link to this section\">\u003Csvg viewBox=\"0 0 16 16\" width=\"13\" height=\"13\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\" aria-hidden=\"true\">\u003Cpath d=\"M6.5 9.5a2.8 2.8 0 0 0 4 0l2.2-2.2a2.8 2.8 0 0 0-4-4l-.7.7\"/>\u003Cpath d=\"M9.5 6.5a2.8 2.8 0 0 0-4 0L3.3 8.7a2.8 2.8 0 0 0 4 4l.7-.7\"/>\u003C/svg>\u003C/a>\u003C/h2>\n\u003Cul>\n\u003Cli>Node 22 or later.\u003C/li>\n\u003Cli>The \u003Ca href=\"https://cli.github.com\" rel=\"noopener\">GitHub CLI\u003C/a>, logged in, if you want to publish to GitHub Pages.\u003C/li>\n\u003C/ul>\n\u003Ch2 id=\"get-the-template\">Get the template\u003Ca class=\"anchor\" href=\"#get-the-template\" aria-label=\"Link to this section\">\u003Csvg viewBox=\"0 0 16 16\" width=\"13\" height=\"13\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\" aria-hidden=\"true\">\u003Cpath d=\"M6.5 9.5a2.8 2.8 0 0 0 4 0l2.2-2.2a2.8 2.8 0 0 0-4-4l-.7.7\"/>\u003Cpath d=\"M9.5 6.5a2.8 2.8 0 0 0-4 0L3.3 8.7a2.8 2.8 0 0 0 4 4l.7-.7\"/>\u003C/svg>\u003C/a>\u003C/h2>\n\u003Cdiv class=\"code edge\">\u003Cpre class=\"shiki css-variables\" style=\"background-color:var(--shiki-background);color:var(--shiki-foreground)\" tabindex=\"0\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--shiki-token-function)\">git\u003C/span>\u003Cspan style=\"color:var(--shiki-token-string)\"> clone\u003C/span>\u003Cspan style=\"color:var(--shiki-token-string)\"> https://github.com/rynf1t/toolsite\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\u003Cbutton type=\"button\" class=\"copy\" aria-label=\"Copy code\">\u003Csvg class=\"idle\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\u003Crect x=\"5.5\" y=\"5.5\" width=\"8\" height=\"8\" rx=\"2\"/>\u003Cpath d=\"M10.5 3.5a1.5 1.5 0 0 0-1.5-1.5H4A1.5 1.5 0 0 0 2.5 3.5V9A1.5 1.5 0 0 0 4 10.5\"/>\u003C/svg>\u003Csvg class=\"done\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\u003Cpath d=\"m3.5 8.5 3 3 6-7\"/>\u003C/svg>\u003C/button>\u003C/div>\n\u003Cp>Keep it somewhere you&#39;ll find it again, like \u003Ccode>~/Projects/toolsite\u003C/code>. You never edit the template to make a site. You make a copy.\u003C/p>\n\u003Ch2 id=\"make-a-site\">Make a site\u003Ca class=\"anchor\" href=\"#make-a-site\" aria-label=\"Link to this section\">\u003Csvg viewBox=\"0 0 16 16\" width=\"13\" height=\"13\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\" aria-hidden=\"true\">\u003Cpath d=\"M6.5 9.5a2.8 2.8 0 0 0 4 0l2.2-2.2a2.8 2.8 0 0 0-4-4l-.7.7\"/>\u003Cpath d=\"M9.5 6.5a2.8 2.8 0 0 0-4 0L3.3 8.7a2.8 2.8 0 0 0 4 4l.7-.7\"/>\u003C/svg>\u003C/a>\u003C/h2>\n\u003Cdiv class=\"code edge\">\u003Cpre class=\"shiki css-variables\" style=\"background-color:var(--shiki-background);color:var(--shiki-foreground)\" tabindex=\"0\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--shiki-token-function)\">toolsite/scripts/new-site.sh\u003C/span>\u003Cspan style=\"color:var(--shiki-token-string)\"> mytool\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\u003Cbutton type=\"button\" class=\"copy\" aria-label=\"Copy code\">\u003Csvg class=\"idle\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\u003Crect x=\"5.5\" y=\"5.5\" width=\"8\" height=\"8\" rx=\"2\"/>\u003Cpath d=\"M10.5 3.5a1.5 1.5 0 0 0-1.5-1.5H4A1.5 1.5 0 0 0 2.5 3.5V9A1.5 1.5 0 0 0 4 10.5\"/>\u003C/svg>\u003Csvg class=\"done\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\u003Cpath d=\"m3.5 8.5 3 3 6-7\"/>\u003C/svg>\u003C/button>\u003C/div>\n\u003Cp>This makes \u003Ccode>mytool-site\u003C/code> next to the template, with a starter config, one docs page, a fresh git repository and its packages installed. Add \u003Ccode>--from\u003C/code> with your tool&#39;s folder and it also brings across the tool&#39;s \u003Ccode>docs/\u003C/code> folder, or its README if there&#39;s no \u003Ccode>docs/\u003C/code>:\u003C/p>\n\u003Cdiv class=\"code edge\">\u003Cpre class=\"shiki css-variables\" style=\"background-color:var(--shiki-background);color:var(--shiki-foreground)\" tabindex=\"0\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--shiki-token-function)\">toolsite/scripts/new-site.sh\u003C/span>\u003Cspan style=\"color:var(--shiki-token-string)\"> mytool\u003C/span>\u003Cspan style=\"color:var(--shiki-token-string)\"> --from\u003C/span>\u003Cspan style=\"color:var(--shiki-token-string)\"> ~/Projects/mytool\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\u003Cbutton type=\"button\" class=\"copy\" aria-label=\"Copy code\">\u003Csvg class=\"idle\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\u003Crect x=\"5.5\" y=\"5.5\" width=\"8\" height=\"8\" rx=\"2\"/>\u003Cpath d=\"M10.5 3.5a1.5 1.5 0 0 0-1.5-1.5H4A1.5 1.5 0 0 0 2.5 3.5V9A1.5 1.5 0 0 0 4 10.5\"/>\u003C/svg>\u003Csvg class=\"done\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\u003Cpath d=\"m3.5 8.5 3 3 6-7\"/>\u003C/svg>\u003C/button>\u003C/div>\n\u003Cp>To publish on your own domain, add \u003Ccode>--domain\u003C/code>. The site goes to \u003Ccode>mytool.example.com\u003C/code>, and the deploy adds the DNS record if the domain is on Cloudflare:\u003C/p>\n\u003Cdiv class=\"code edge\">\u003Cpre class=\"shiki css-variables\" style=\"background-color:var(--shiki-background);color:var(--shiki-foreground)\" tabindex=\"0\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--shiki-token-function)\">toolsite/scripts/new-site.sh\u003C/span>\u003Cspan style=\"color:var(--shiki-token-string)\"> mytool\u003C/span>\u003Cspan style=\"color:var(--shiki-token-string)\"> --from\u003C/span>\u003Cspan style=\"color:var(--shiki-token-string)\"> ~/Projects/mytool\u003C/span>\u003Cspan style=\"color:var(--shiki-token-string)\"> --domain\u003C/span>\u003Cspan style=\"color:var(--shiki-token-string)\"> example.com\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\u003Cbutton type=\"button\" class=\"copy\" aria-label=\"Copy code\">\u003Csvg class=\"idle\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\u003Crect x=\"5.5\" y=\"5.5\" width=\"8\" height=\"8\" rx=\"2\"/>\u003Cpath d=\"M10.5 3.5a1.5 1.5 0 0 0-1.5-1.5H4A1.5 1.5 0 0 0 2.5 3.5V9A1.5 1.5 0 0 0 4 10.5\"/>\u003C/svg>\u003Csvg class=\"done\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\u003Cpath d=\"m3.5 8.5 3 3 6-7\"/>\u003C/svg>\u003C/button>\u003C/div>\n\u003Cp>The \u003Ca href=\"/docs/quick-start\">quick start\u003C/a> goes from here to a published site.\u003C/p>\n","/docs/installation","Start",null,{"title":9,"path":10},"Quick start","/docs/quick-start"],"uses":{"params":["page"]}}]}
