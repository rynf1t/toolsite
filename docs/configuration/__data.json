{"type":"data","nodes":[null,{"type":"data","data":[{"nav":1},[2,34,135],{"label":3,"items":4},"Start",[5,18],{"title":6,"path":7,"headings":8},"Installation","/docs/installation",[9,12,15],{"id":10,"text":11},"what-you-need","What you need",{"id":13,"text":14},"get-the-template","Get the template",{"id":16,"text":17},"make-a-site","Make a site",{"title":19,"path":20,"headings":21},"Quick start","/docs/quick-start",[22,25,28,31],{"id":23,"text":24},"1-make-the-site","1. Make the site",{"id":26,"text":27},"2-fill-in-the-config","2. Fill in the config",{"id":29,"text":30},"3-write-the-docs","3. Write the docs",{"id":32,"text":33},"4-publish","4. Publish",{"label":35,"items":36},"Guide",[37,53,78,90,103,119],{"title":38,"path":39,"headings":40},"Configuration","/docs/configuration",[41,44,47,50],{"id":42,"text":43},"fields","Fields",{"id":45,"text":46},"colours","Colours",{"id":48,"text":49},"sections","Sections",{"id":51,"text":52},"the-hero","The hero",{"title":54,"path":55,"headings":56},"Writing docs","/docs/writing-docs",[57,60,63,66,69,72,75],{"id":58,"text":59},"file-names","File names",{"id":61,"text":62},"front-matter","Front matter",{"id":64,"text":65},"the-lead","The lead",{"id":67,"text":68},"headings","Headings",{"id":70,"text":71},"code","Code",{"id":73,"text":74},"links","Links",{"id":76,"text":77},"good-docs-pages","Good docs pages",{"title":79,"path":80,"headings":81},"Changelog","/docs/changelog",[82,83,84,87],{"id":58,"text":59},{"id":61,"text":62},{"id":85,"text":86},"writing-an-entry","Writing an entry",{"id":88,"text":89},"what-the-site-makes-from-it","What the site makes from it",{"title":91,"path":92,"headings":93},"Custom hero and styles","/docs/custom-code",[94,97,100],{"id":95,"text":96},"a-custom-hero","A custom hero",{"id":98,"text":99},"custom-styles","Custom styles",{"id":101,"text":102},"everything-else","Everything else",{"title":104,"path":105,"headings":106},"Deploying","/docs/deploying",[107,110,113,116],{"id":108,"text":109},"what-it-does","What it does",{"id":111,"text":112},"your-own-domain","Your own domain",{"id":114,"text":115},"taking-a-site-down","Taking a site down",{"id":117,"text":118},"somewhere-else","Somewhere else",{"title":120,"path":121,"headings":122},"Updating a site","/docs/updating",[123,126,129,132],{"id":124,"text":125},"run-it","Run it",{"id":127,"text":128},"what-it-changes","What it changes",{"id":130,"text":131},"what-it-leaves-alone","What it leaves alone",{"id":133,"text":134},"where-the-template-comes-from","Where the template comes from",{"label":136,"items":137},"Reference",[138,148],{"title":139,"path":140,"headings":141},"Agents","/docs/agents",[142,145],{"id":143,"text":144},"having-an-agent-build-the-site","Having an agent build the site",{"id":146,"text":147},"reading-a-published-site","Reading a published site",{"title":149,"path":150,"headings":151},"Limits","/docs/limits",[152,155,158,161],{"id":153,"text":154},"two-tools-on-one-site","Two tools on one site",{"id":156,"text":157},"dns-only-on-cloudflare","DNS only on Cloudflare",{"id":159,"text":160},"github-pages-needs-a-public-repository","GitHub Pages needs a public repository",{"id":162,"text":163},"template-code-is-the-templates","Template code is the template's"],"uses":{}},{"type":"data","data":[{"doc":1,"prev":7,"next":10},{"title":2,"description":3,"html":4,"path":5,"group":6},"Configuration","Every field in site.config.ts.","\u003Cp class=\"lead\">\u003Ccode>site.config.ts\u003C/code> holds everything that makes the site about your tool. The landing page, its Markdown copy, \u003Ccode>llms.txt\u003C/code>, the header, the favicon and the colours all read from it.\u003C/p>\n\u003Ch2 id=\"fields\">Fields\u003Ca class=\"anchor\" href=\"#fields\" aria-label=\"Link to this section\">\u003Csvg viewBox=\"0 0 16 16\" width=\"13\" height=\"13\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\" aria-hidden=\"true\">\u003Cpath d=\"M6.5 9.5a2.8 2.8 0 0 0 4 0l2.2-2.2a2.8 2.8 0 0 0-4-4l-.7.7\"/>\u003Cpath d=\"M9.5 6.5a2.8 2.8 0 0 0-4 0L3.3 8.7a2.8 2.8 0 0 0 4 4l.7-.7\"/>\u003C/svg>\u003C/a>\u003C/h2>\n\u003Cdiv class=\"table edge\">\u003Ctable>\u003Cthead>\u003Ctr>\u003Cth scope=\"col\">Field\u003C/th>\u003Cth scope=\"col\">What it&#39;s for\u003C/th>\u003C/tr>\u003C/thead>\u003Ctbody>\u003Ctr>\u003Ctd>\u003Ccode>name\u003C/code>\u003C/td>\u003Ctd>The tool&#39;s name, as you&#39;d write it in a sentence. Shown in the header and page titles.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>description\u003C/code>\u003C/td>\u003Ctd>One sentence a stranger understands. Used in meta tags and \u003Ccode>llms.txt\u003C/code>.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>repo\u003C/code>\u003C/td>\u003Ctd>The tool&#39;s source. The header&#39;s GitHub link goes here.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>origin\u003C/code>\u003C/td>\u003Ctd>Where the site lives, such as \u003Ccode>https://you.github.io/mytool-site\u003C/code>. Links in the Markdown copies are built from it.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>install\u003C/code>\u003C/td>\u003Ctd>The first command someone runs. Shown with a copy button.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>requirement\u003C/code>\u003C/td>\u003Ctd>What it needs, printed under the install line.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>status\u003C/code>\u003C/td>\u003Ctd>Optional. A short chip above the headline, such as \u003Ccode>Early\u003C/code> or \u003Ccode>v1.2\u003C/code>.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>colours\u003C/code>\u003C/td>\u003Ctd>Two hues. See \u003Ca href=\"#colours\">Colours\u003C/a>.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>mark\u003C/code>\u003C/td>\u003Ctd>Optional. The inside of a 20 by 20 SVG for the header and favicon.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>hero\u003C/code>\u003C/td>\u003Ctd>The headline, the lead paragraph, and a screenshot or code sample.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>sections\u003C/code>\u003C/td>\u003Ctd>The landing page bands. See \u003Ca href=\"#sections\">Sections\u003C/a>.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>questions\u003C/code>\u003C/td>\u003Ctd>The questions at the bottom of the landing page.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>nav\u003C/code>\u003C/td>\u003Ctd>Optional. Extra header links after Docs, such as a second tool&#39;s docs group.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>author\u003C/code>\u003C/td>\u003Ctd>Optional. Who made it, as \u003Ccode>{ label, href }\u003C/code>, linked at the end of the footer.\u003C/td>\u003C/tr>\u003C/tbody>\u003C/table>\u003C/div>\n\u003Cp>Text fields take inline Markdown: \u003Ccode>code\u003C/code>, bold, and links. A link that starts with \u003Ccode>/\u003C/code> is a path on this site.\u003C/p>\n\u003Ch2 id=\"colours\">Colours\u003Ca class=\"anchor\" href=\"#colours\" aria-label=\"Link to this section\">\u003Csvg viewBox=\"0 0 16 16\" width=\"13\" height=\"13\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\" aria-hidden=\"true\">\u003Cpath d=\"M6.5 9.5a2.8 2.8 0 0 0 4 0l2.2-2.2a2.8 2.8 0 0 0-4-4l-.7.7\"/>\u003Cpath d=\"M9.5 6.5a2.8 2.8 0 0 0-4 0L3.3 8.7a2.8 2.8 0 0 0 4 4l.7-.7\"/>\u003C/svg>\u003C/a>\u003C/h2>\n\u003Cdiv class=\"code edge\">\u003Cpre class=\"shiki css-variables\" style=\"background-color:var(--shiki-background);color:var(--shiki-foreground)\" tabindex=\"0\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--shiki-foreground)\">colours\u003C/span>\u003Cspan style=\"color:var(--shiki-token-punctuation)\">:\u003C/span>\u003Cspan style=\"color:var(--shiki-foreground)\"> { tint\u003C/span>\u003Cspan style=\"color:var(--shiki-token-punctuation)\">:\u003C/span>\u003Cspan style=\"color:var(--shiki-token-constant)\"> 255\u003C/span>\u003Cspan style=\"color:var(--shiki-token-punctuation)\">,\u003C/span>\u003Cspan style=\"color:var(--shiki-foreground)\"> accent\u003C/span>\u003Cspan style=\"color:var(--shiki-token-punctuation)\">:\u003C/span>\u003Cspan style=\"color:var(--shiki-token-constant)\"> 75\u003C/span>\u003Cspan style=\"color:var(--shiki-foreground)\"> }\u003C/span>\u003Cspan style=\"color:var(--shiki-token-punctuation)\">,\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\u003Cbutton type=\"button\" class=\"copy\" aria-label=\"Copy code\">\u003Csvg class=\"idle\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\u003Crect x=\"5.5\" y=\"5.5\" width=\"8\" height=\"8\" rx=\"2\"/>\u003Cpath d=\"M10.5 3.5a1.5 1.5 0 0 0-1.5-1.5H4A1.5 1.5 0 0 0 2.5 3.5V9A1.5 1.5 0 0 0 4 10.5\"/>\u003C/svg>\u003Csvg class=\"done\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\u003Cpath d=\"m3.5 8.5 3 3 6-7\"/>\u003C/svg>\u003C/button>\u003C/div>\n\u003Cp>Both are hues on the oklch colour wheel, from 0 to 360. Roughly: 25 red, 75 amber, 150 green, 200 teal, 255 blue, 300 violet.\u003C/p>\n\u003Cul>\n\u003Cli>\u003Ccode>tint\u003C/code> nudges every grey on the page toward a hue. The greys stay grey. They just feel warm or cool.\u003C/li>\n\u003Cli>\u003Ccode>accent\u003C/code> is the one colour with jobs: the text caret, selection, search highlights, the status dot and one syntax colour. It appears nowhere else.\u003C/li>\n\u003C/ul>\n\u003Cp>Focus rings get their own hue, picked to stay clear of the accent. Light and dark palettes, shadows, the browser&#39;s theme colour and the favicon all follow from these two numbers.\u003C/p>\n\u003Ch2 id=\"sections\">Sections\u003Ca class=\"anchor\" href=\"#sections\" aria-label=\"Link to this section\">\u003Csvg viewBox=\"0 0 16 16\" width=\"13\" height=\"13\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\" aria-hidden=\"true\">\u003Cpath d=\"M6.5 9.5a2.8 2.8 0 0 0 4 0l2.2-2.2a2.8 2.8 0 0 0-4-4l-.7.7\"/>\u003Cpath d=\"M9.5 6.5a2.8 2.8 0 0 0-4 0L3.3 8.7a2.8 2.8 0 0 0 4 4l.7-.7\"/>\u003C/svg>\u003C/a>\u003C/h2>\n\u003Cp>Each section is a band on the landing page: copy on the left, and something to look at on the right.\u003C/p>\n\u003Cdiv class=\"code edge\">\u003Cpre class=\"shiki css-variables\" style=\"background-color:var(--shiki-background);color:var(--shiki-foreground)\" tabindex=\"0\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--shiki-foreground)\">{\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--shiki-foreground)\">  eyebrow\u003C/span>\u003Cspan style=\"color:var(--shiki-token-punctuation)\">:\u003C/span>\u003Cspan style=\"color:var(--shiki-token-string-expression)\"> 'Jump'\u003C/span>\u003Cspan style=\"color:var(--shiki-token-punctuation)\">,\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--shiki-foreground)\">  title\u003C/span>\u003Cspan style=\"color:var(--shiki-token-punctuation)\">:\u003C/span>\u003Cspan style=\"color:var(--shiki-token-string-expression)\"> 'Enter takes you there.'\u003C/span>\u003Cspan style=\"color:var(--shiki-token-punctuation)\">,\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--shiki-foreground)\">  body\u003C/span>\u003Cspan style=\"color:var(--shiki-token-punctuation)\">:\u003C/span>\u003Cspan style=\"color:var(--shiki-token-string-expression)\"> 'Two or three sentences. Inline `code` and [links](/docs/commands) work.'\u003C/span>\u003Cspan style=\"color:var(--shiki-token-punctuation)\">,\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--shiki-foreground)\">  link\u003C/span>\u003Cspan style=\"color:var(--shiki-token-punctuation)\">:\u003C/span>\u003Cspan style=\"color:var(--shiki-foreground)\"> { label\u003C/span>\u003Cspan style=\"color:var(--shiki-token-punctuation)\">:\u003C/span>\u003Cspan style=\"color:var(--shiki-token-string-expression)\"> 'Commands'\u003C/span>\u003Cspan style=\"color:var(--shiki-token-punctuation)\">,\u003C/span>\u003Cspan style=\"color:var(--shiki-foreground)\"> href\u003C/span>\u003Cspan style=\"color:var(--shiki-token-punctuation)\">:\u003C/span>\u003Cspan style=\"color:var(--shiki-token-string-expression)\"> '/docs/commands'\u003C/span>\u003Cspan style=\"color:var(--shiki-foreground)\"> }\u003C/span>\u003Cspan style=\"color:var(--shiki-token-punctuation)\">,\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--shiki-token-comment)\">  // then at most one of these\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--shiki-foreground)\">  items\u003C/span>\u003Cspan style=\"color:var(--shiki-token-punctuation)\">:\u003C/span>\u003Cspan style=\"color:var(--shiki-foreground)\"> [{ name\u003C/span>\u003Cspan style=\"color:var(--shiki-token-keyword)\">:\u003C/span>\u003Cspan style=\"color:var(--shiki-token-string-expression)\"> 'enter'\u003C/span>\u003Cspan style=\"color:var(--shiki-token-punctuation)\">,\u003C/span>\u003Cspan style=\"color:var(--shiki-foreground)\"> text\u003C/span>\u003Cspan style=\"color:var(--shiki-token-keyword)\">:\u003C/span>\u003Cspan style=\"color:var(--shiki-token-string-expression)\"> 'Jump to the pane'\u003C/span>\u003Cspan style=\"color:var(--shiki-foreground)\"> }]\u003C/span>\u003Cspan style=\"color:var(--shiki-token-punctuation)\">,\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--shiki-foreground)\">  code\u003C/span>\u003Cspan style=\"color:var(--shiki-token-punctuation)\">:\u003C/span>\u003Cspan style=\"color:var(--shiki-token-string-expression)\"> '# a comment\\nmytool run --json'\u003C/span>\u003Cspan style=\"color:var(--shiki-token-punctuation)\">,\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--shiki-foreground)\">  image\u003C/span>\u003Cspan style=\"color:var(--shiki-token-punctuation)\">:\u003C/span>\u003Cspan style=\"color:var(--shiki-foreground)\"> { src\u003C/span>\u003Cspan style=\"color:var(--shiki-token-punctuation)\">:\u003C/span>\u003Cspan style=\"color:var(--shiki-token-string-expression)\"> '/jump.webp'\u003C/span>\u003Cspan style=\"color:var(--shiki-token-punctuation)\">,\u003C/span>\u003Cspan style=\"color:var(--shiki-foreground)\"> alt\u003C/span>\u003Cspan style=\"color:var(--shiki-token-punctuation)\">:\u003C/span>\u003Cspan style=\"color:var(--shiki-token-string-expression)\"> 'The pane after a jump'\u003C/span>\u003Cspan style=\"color:var(--shiki-token-punctuation)\">,\u003C/span>\u003Cspan style=\"color:var(--shiki-foreground)\"> width\u003C/span>\u003Cspan style=\"color:var(--shiki-token-punctuation)\">:\u003C/span>\u003Cspan style=\"color:var(--shiki-token-constant)\"> 1600\u003C/span>\u003Cspan style=\"color:var(--shiki-token-punctuation)\">,\u003C/span>\u003Cspan style=\"color:var(--shiki-foreground)\"> height\u003C/span>\u003Cspan style=\"color:var(--shiki-token-punctuation)\">:\u003C/span>\u003Cspan style=\"color:var(--shiki-token-constant)\"> 1000\u003C/span>\u003Cspan style=\"color:var(--shiki-foreground)\"> }\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--shiki-foreground)\">}\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\u003Cbutton type=\"button\" class=\"copy\" aria-label=\"Copy code\">\u003Csvg class=\"idle\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\u003Crect x=\"5.5\" y=\"5.5\" width=\"8\" height=\"8\" rx=\"2\"/>\u003Cpath d=\"M10.5 3.5a1.5 1.5 0 0 0-1.5-1.5H4A1.5 1.5 0 0 0 2.5 3.5V9A1.5 1.5 0 0 0 4 10.5\"/>\u003C/svg>\u003Csvg class=\"done\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\u003Cpath d=\"m3.5 8.5 3 3 6-7\"/>\u003C/svg>\u003C/button>\u003C/div>\n\u003Cp>Leave all three out and the copy stands alone. Images go in \u003Ccode>static/\u003C/code>. Give them \u003Ccode>width\u003C/code> and \u003Ccode>height\u003C/code>, the image&#39;s real pixel size, so the page doesn&#39;t jump while they load. WebP keeps them small: \u003Ccode>cwebp -q 82 shot.png -o shot.webp\u003C/code>.\u003C/p>\n\u003Ch2 id=\"the-hero\">The hero\u003Ca class=\"anchor\" href=\"#the-hero\" aria-label=\"Link to this section\">\u003Csvg viewBox=\"0 0 16 16\" width=\"13\" height=\"13\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\" aria-hidden=\"true\">\u003Cpath d=\"M6.5 9.5a2.8 2.8 0 0 0 4 0l2.2-2.2a2.8 2.8 0 0 0-4-4l-.7.7\"/>\u003Cpath d=\"M9.5 6.5a2.8 2.8 0 0 0-4 0L3.3 8.7a2.8 2.8 0 0 0 4 4l.7-.7\"/>\u003C/svg>\u003C/a>\u003C/h2>\n\u003Cp>Show the tool working. Use \u003Ccode>image\u003C/code> for a screenshot in \u003Ccode>static/\u003C/code>, or \u003Ccode>code\u003C/code> for a short terminal session. In a terminal sample the first word of each command is coloured as the program, and lines starting with \u003Ccode>#\u003C/code> are comments.\u003C/p>\n\u003Cp>For a live demo, add \u003Ccode>src/custom/Hero.svelte\u003C/code>. See \u003Ca href=\"/docs/custom-code\">Custom hero and styles\u003C/a>.\u003C/p>\n","/docs/configuration","Guide",{"title":8,"path":9},"Quick start","/docs/quick-start",{"title":11,"path":12},"Writing docs","/docs/writing-docs"],"uses":{"params":["page"]}}]}
